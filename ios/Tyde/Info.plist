    <key>NSMicrophoneUsageDescription</key><string>Talk with your Tyde agent.</string>
    <key>WKAppBoundDomains</key><array><string>$(TYDE_NATIVE_BOOTSTRAP_HOST)</string></array>
    <key>CFBundleURLTypes</key><array><dict><key>CFBundleURLName</key><string>Tyde authentication</string><key>CFBundleURLSchemes</key><array><string>tyde-mobile</string></array></dict></array>
</dict></plist>
