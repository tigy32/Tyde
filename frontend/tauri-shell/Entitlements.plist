<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Referenced from `tauri.conf.json` as `bundle.macOS.entitlements`.

  The release build signs with the hardened runtime (`build.sh`:
  `codesign --force --options runtime --deep`). Under the hardened runtime a
  process cannot open an audio input device unless it carries
  `com.apple.security.device.audio-input`, regardless of TCC consent — so this
  entitlement and `Info.plist`'s NSMicrophoneUsageDescription are both required
  and neither substitutes for the other.

  Known gap, not fixable from this directory: `build.sh`'s `sign_and_notarize`
  re-signs the bundle with `--force` and passes no `--entitlements`, which
  strips whatever the bundler applied. That flag has to be added by the owner
  of `build.sh`. See desktop_implementation.md.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
