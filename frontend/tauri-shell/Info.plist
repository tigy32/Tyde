<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the generated bundle Info.plist by the Tauri bundler, which picks
  up an `Info.plist` sitting next to `tauri.conf.json`
  (tauri-utils MacConfig::info_plist).

  macOS refuses microphone access to a process with no usage description, so
  this is required before `getUserMedia` can succeed in a packaged build. It is
  necessary but not sufficient — see `Entitlements.plist` for the hardened
  runtime half.
-->
<plist version="1.0">
<dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>Tyde uses your microphone only while you have voice mode turned on in a chat, so you can talk to the agent instead of typing. Audio is sent to the Tyde server you chose and is not recorded to disk.</string>
</dict>
</plist>
